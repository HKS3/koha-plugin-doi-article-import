[% PROCESS 'i18n.inc' %]
[% INCLUDE 'doc-head-open.inc' %]
<title>[% t('Configure DOI Article Import') | html %]</title>
[% INCLUDE 'doc-head-close.inc' %]
</head>
<body id="tools_plugins" class="tools">
[% INCLUDE 'header.inc' %]
[% INCLUDE 'cat-search.inc' %]

<div id="breadcrumbs">
    <a href="/cgi-bin/koha/mainpage.pl">[% t('Home') | html %]</a>
    &rsaquo; <a href="/cgi-bin/koha/plugins/plugins-home.pl">[% t('Plugins') | html %]</a>
    &rsaquo; [% t('Configure DOI Article Import') | html %]
</div>

<div class="main container-fluid">
    <div class="row">
        <div class="col-sm-10 col-sm-push-2">
            <main>
                <h1>[% t('Configure DOI Article Import') | html %]</h1>

                [% IF crossref_plugin_email %]
                    <div class="alert alert-info">
                        [% t('Fallback from koha-plugin-api-crossref is available.') | html %]
                    </div>
                [% END %]

                <form method="post" action="/cgi-bin/koha/plugins/run.pl" class="form-horizontal">
                    [% INCLUDE 'csrf-token.inc' %]
                    <input type="hidden" name="class" value="[% plugin_class | html %]" />
                    <input type="hidden" name="method" value="configure" />
                    <input type="hidden" name="op" value="cud-save" />
                    <input type="hidden" name="save" value="1" />

                    <fieldset class="rows">
                        <ol>
                            <li>
                                <label for="crossref_email_address">[% t('Crossref email address') | html %]</label>
                                <input id="crossref_email_address" name="crossref_email_address" type="email" size="60" value="[% config.crossref_email_address | html %]" />
                            </li>
                            <li>
                                <label for="frameworkcode">[% t('Default framework') | html %]</label>
                                <select id="frameworkcode" name="frameworkcode">
                                    [% FOREACH framework IN frameworks %]
                                        <option value="[% framework.frameworkcode | html %]" [% IF framework.frameworkcode == config.frameworkcode %]selected="selected"[% END %]>[% framework.frameworktext | html %] ([% framework.frameworkcode | html %])</option>
                                    [% END %]
                                </select>
                            </li>
                            <li>
                                <label for="itemtype">[% t('Default value for 942$c') | html %]</label>
                                <input id="itemtype" name="itemtype" type="text" size="10" value="[% config.itemtype | html %]" />
                            </li>
                        </ol>
                    </fieldset>

                    <fieldset class="action">
                        <button class="btn btn-primary" type="submit">[% t('Save') | html %]</button>
                    </fieldset>
                </form>
            </main>
        </div>
        <div class="col-sm-2 col-sm-pull-10">
            [% INCLUDE 'tools-menu.inc' %]
        </div>
    </div>
</div>

[% INCLUDE 'intranet-bottom.inc' %]
